{
  "schemaVersion": 1,
  "id": "recordmc",
  "version": "${version}",
  "name": "RecordMC",
  "description": "Minecraft内で簡単に動画と音声を録画・保存できるMod",
  "authors": [
    "AtsukiMC"
  ],
  "contact": {},
  "license": "Apache-2.0",
  "icon": "assets/recordmc/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.atsukimc.recordmc.RecordMCClient"
    ],
    "modmenu": [
      "com.atsukimc.recordmc.compat.modmenu.RecordModMenuApi"
    ]
  },
  "mixins": [
    "recordmc.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.14.0",
    "minecraft": "~1.18.2",
    "java": ">=17",
    "fabric": "*",
    "malilib": ">=0.12.0"
  }
}
